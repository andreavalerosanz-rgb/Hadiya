[Unit]
Description=Flows (Claude Code workbench)
After=network.target

[Service]
Type=simple
User=flows
Group=flows
WorkingDirectory=/opt/flows
Environment=PORT=8787
ExecStart=/usr/bin/python3 /opt/flows/server.py
Restart=on-failure
RestartSec=3

# Hardening. Do NOT set NoNewPrivileges: the server uses sudo to run claude as other users.
ProtectSystem=full
ReadWritePaths=/opt/flows/data
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# ProtectHome is left off: sudo'd claude runs as other users with their own homes.

[Install]
WantedBy=multi-user.target
