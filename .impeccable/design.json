  "narrative": {
    "northStar": "Flows on Paper",
    "overview": "The same brand made calm and light. A warm paper ground, white cards with hairlines, ink text, and one orange that only ever says press this or this needs you. One column, one obvious action, plain Spanish. The film world survives as brand parts: reel logo, Barlow with condensed caps for small labels, the Flows state marks, and one perforated orange strip.",
    "keyCharacteristics": [
      "One column, mobile-first; centered about 680px on desktop.",
      "Orange only on the primary action, the Te necesita flag, focus, selection and the one perforated strip.",
      "State is always a mark plus a word.",
      "Flat paper: hairlines and a very soft card shadow.",
      "Targets 44-56px; 3px deep-orange focus ring."
    ],
    "rules": [
      {
        "name": "The Orange Is Action Rule",
        "body": "Orange says press or you are needed, or marks focus. Not decoration, headings, links or secondary buttons; the perforated strip is the single film echo.",
        "section": "colors"
      },
      {
        "name": "The Word Beside Mark Rule",
        "body": "Every state is a mark plus its word; colour never carries state.",
        "section": "colors"
      },
      {
        "name": "The Caps Are Small Rule",
        "body": "Condensed caps are for labels, state words, the logo and the primary button, never headings or running text.",
        "section": "typography"
      },
      {
        "name": "The One Voice Rule",
        "body": "No third family; emphasis is weight within Barlow.",
        "section": "typography"
      },
      {
        "name": "The Paper Stays Flat Rule",
        "body": "Surfaces are white on paper with a hairline; selection is an ink border plus a 1px inset ring, not a lift.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pair every state with its mark and word, using the five Flows marks.",
      "Do keep text on orange in Bench Ink and put orange only on the primary action, the Te necesita flag, focus, selection and the one strip.",
      "Do build new surfaces from white cards with a 1px Paper Line border on Paper Ground, 12px radius, in the single 680px column.",
      "Do keep targets at least 44px and the 3px Flag Orange Deep focus ring.",
      "Do write new copy in plain Spanish tú and put the next step in every error.",
      "Do keep admin rules scoped to body.adm."
    ],
    "donts": [
      "Don't show tool names, model names, paths, costs or permission jargon; translate to a plain Spanish line.",
      "Don't convey state by colour alone, or invent per-errand colours.",
      "Don't add a second perforated strip, a sidebar, or dark panels to this world.",
      "Don't use condensed caps for headings or running text.",
      "Don't open a modal for anything but a blocking decision."
    ]
  }
